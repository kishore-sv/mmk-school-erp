# Root environment template for local development.
# Copy the values each application needs into that application's own .env.
# Do not commit .env files. These values are local defaults, not production secrets.
#
# Ownership:
# - POSTGRES_* and POSTGRES_URL: Docker Compose and server/
# - REDIS_URL: Docker Compose is not required to read it; worker/ connects with it
# - STORAGE_*: server/
# - FIREBASE_*: reserved for a future Firebase Cloud Messaging integration.
#   No application reads these values yet. Leave them empty.
# - CORS_ORIGINS: server/
# - MINIO_ROOT_*: Docker Compose. They must match STORAGE_ACCESS_KEY_ID and
#   STORAGE_SECRET_ACCESS_KEY when STORAGE_PROVIDER=minio.
#
# The setup task's Compose example defaulted MINIO_ROOT_PASSWORD to minioadmin,
# while this environment example uses a different local secret. The Compose file
# uses change-this-local-secret so the API and MinIO accept the same local key.

NODE_ENV=development

POSTGRES_PASSWORD=schoolerp_dev_password
POSTGRES_URL=postgresql://schoolerp:schoolerp_dev_password@127.0.0.1:5432/schoolerp

REDIS_URL=redis://127.0.0.1:6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-secret

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mmk-erp-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=change-this-local-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Platform Admin session signing secret. Must match server/.env.
# At least 32 characters. Not a password and not a production secret in this example.
PLATFORM_ACCESS_TOKEN_SECRET=

# Initial Platform Admin seed. The password belongs only in an untracked .env file.
PLATFORM_ADMIN_SEED_EMAIL=mmkerp@gmail.com
PLATFORM_ADMIN_SEED_PASSWORD=
PLATFORM_ADMIN_SEED_NAME=MMK Platform Administrator
