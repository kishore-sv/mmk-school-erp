# Server — local development only.
# Copy to server/.env. Do not commit server/.env.
# Bun loads this file when commands run from server/.

NODE_ENV=development
PORT=4000

# Owned by the server. Must match the Compose PostgreSQL settings.
POSTGRES_URL=postgresql://schoolerp:schoolerp_dev_password@127.0.0.1:5432/schoolerp

# Comma-separated browser origins. Empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Owned by the server. Local default is MinIO. Change the provider name
# and endpoint without changing application modules.
# The configured bucket is private and is not created automatically.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mmk-erp-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=change-this-local-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=

# Signs Platform Admin access tokens. Use a unique random value of at least 32 characters.
# The platform-admin app must use the same value for server-side route checks.
PLATFORM_ACCESS_TOKEN_SECRET=

# Signs School Admin sessions. Use a different value from the platform secret.
SCHOOL_ACCESS_TOKEN_SECRET=
REDIS_URL=redis://127.0.0.1:6379
SCHOOL_ADMIN_LOCAL_BASE_DOMAIN=localhost
SCHOOL_PORTAL_LOCAL_BASE_DOMAIN=localhost
SCHOOL_ADMIN_PRODUCTION_BASE_DOMAIN=admin.mmkerp.tech
SCHOOL_PORTAL_PRODUCTION_BASE_DOMAIN=mmkerp.tech
SCHOOL_ADMIN_LOCAL_PORT=3001
SCHOOL_PORTAL_LOCAL_PORT=3002
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_PROVIDER=console
EMAIL_FROM=MMK School ERP <noreply@mmkerp.tech>
SUPPORT_EMAIL=support@mmkerp.tech
WORKER_CONCURRENCY=2

# Used only by `bun run db:seed`. Leave the password empty in git.
# Set it in the untracked server/.env. Production seeding must be an explicit command.
PLATFORM_ADMIN_SEED_EMAIL=mmkerp@gmail.com
PLATFORM_ADMIN_SEED_PASSWORD=
PLATFORM_ADMIN_SEED_NAME=MMK Platform Administrator

# Optional. When set, lifecycle OTP codes use this fixed 6-digit value (local/test).
# PLATFORM_OTP_DEV_CODE=123456
