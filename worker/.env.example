# Worker — local development only.
# Copy to worker/.env. Do not commit worker/.env.

NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379

# Firebase Cloud Messaging is the planned mobile push provider.
# These values are reserved and are not read by the worker yet.
# Do not put real credentials in this example.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
